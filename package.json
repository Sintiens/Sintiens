{
  "name": "Sintiens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-server/server.cjs",
    "prebuild": "npm run validate:news && npm run validate:all && npm run generate:news",
    "preview": "vite preview",
    "start": "node dist-server/server.cjs",
    "clean": "node -e \"for (const d of ['dist','dist-server']) { try { require('fs').rmSync(d,{recursive:true,force:true}); console.log('removed '+d); } catch(e){} }\"",
    "lint": "tsc --noEmit",
    "validate:news": "node scripts/validate-news.mjs",
    "validate:all": "node scripts/validate-all.mjs",
    "generate:rss": "node scripts/generate-rss.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:news": "node scripts/generate-rss.mjs && node scripts/generate-sitemap.mjs",
    "favicons": "node scripts/generate-favicons.mjs",
    "pwa-assets": "node scripts/generate-pwa-assets.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "recharts": "^3.8.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "terser": "^5.49.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
