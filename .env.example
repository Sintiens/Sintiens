# .env.example — copia a .env y rellena (nunca commitees .env)
GEMINI_API_KEY=
# URL canónica pública (Oracle). Usada por sitemap/RSS/OG.
SITE_URL=https://sintiens.org
VITE_SITE_URL=https://sintiens.org
PORT=3000
NODE_ENV=development
# Token opcional para proteger /api/dev/* incluso en desarrollo.
# Si se define, hay que enviar Authorization: Bearer <token>.
DEV_TOKEN=
# Orígenes extra permitidos para /api/* (coma-separados). Por defecto same-origin + SITE_URL.
CORS_ORIGIN=

# Twitter / X API v2 (para scripts/publish-twitter-thread.mjs)
# Obtén estas 4 claves gratis en https://developer.x.com
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
